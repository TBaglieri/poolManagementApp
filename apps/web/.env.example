# PoolOps Pro — Web (Next.js) environment variables
# Copy this file to `.env.local` and fill in values. NEVER commit `.env.local`.

# Public Supabase config (safe to expose to the browser — anon/publishable key only)
NEXT_PUBLIC_SUPABASE_URL=https://bqhhbekmqsmfkxyzdvol.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_DBaasd3KSY392tsSUy3wQQ_VFE3EM_a

# Data mode: "supabase" reads/writes Postgres via RLS; "mock" uses bundled demo data.
# The app falls back to mock automatically if Supabase is not configured.
NEXT_PUBLIC_DATA_MODE=supabase

# ---------------------------------------------------------------------------
# SERVER-ONLY SECRETS — never prefix with NEXT_PUBLIC_, never expose to browser
# ---------------------------------------------------------------------------
# Service role key BYPASSES Row Level Security. Paste the ROTATED key here only.
# The previously-exposed key must be rotated in the Supabase dashboard first.
SUPABASE_SERVICE_ROLE_KEY=PASTE_ROTATED_SERVICE_ROLE_KEY_HERE

# Stripe (placeholder — see STRIPE_SETUP.md). Leave blank in demo mode.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
