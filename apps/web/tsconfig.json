{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "ES2020"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@poolops/shared": ["../../packages/shared/src/index.ts"],
      "@poolops/shared/*": ["../../packages/shared/src/*"],
      "@poolops/scheduling": ["../../packages/scheduling/src/index.ts"],
      "@poolops/scheduling/*": ["../../packages/scheduling/src/*"],
      "@poolops/supabase": ["../../packages/supabase/src/index.ts"],
      "@poolops/supabase/*": ["../../packages/supabase/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
