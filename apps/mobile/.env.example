# PoolOps Pro — Mobile (Expo) environment variables
# Copy this file to `.env` and fill in values. NEVER commit `.env`.
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the app bundle.
# NEVER put the Supabase service role key or any secret in the mobile app —
# only the PUBLISHABLE / anon key (begins with sb_publishable_ or the legacy eyJ...).

# Base project URL — NO trailing "/rest/v1/".
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY

# Data mode: "supabase" or "mock" (falls back to mock if not configured).
EXPO_PUBLIC_DATA_MODE=supabase
