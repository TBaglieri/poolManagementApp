{
  "name": "poolops-pro",
  "version": "0.1.0",
  "private": true,
  "description": "PoolOps Pro — aquatics & community-pool operations platform (web + mobile monorepo).",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace @poolops/web",
    "build:web": "npm run build --workspace @poolops/web",
    "start:web": "npm run start --workspace @poolops/web",
    "lint:web": "npm run lint --workspace @poolops/web",
    "typecheck": "npm run typecheck --workspace @poolops/web",
    "dev:mobile": "npm --prefix apps/mobile run start",
    "install:mobile": "npm --prefix apps/mobile install",
    "seed:villas": "tsx scripts/seed-villas.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "link-staff-profiles": "tsx scripts/link-staff-profiles.ts",
    "review-invite-roles": "tsx scripts/review-invite-roles.ts",
    "verify-setup": "tsx scripts/verify-setup.ts",
    "check-org-slugs": "tsx scripts/check-org-slugs.ts",
    "db:bundle": "node scripts/build-run-all.mjs",
    "db:apply": "node scripts/apply-supabase-sql.mjs",
    "db:apply:seed": "node scripts/apply-supabase-sql.mjs --with-seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "tsx": "^4.19.1",
    "vitest": "^4.1.10"
  }
}
